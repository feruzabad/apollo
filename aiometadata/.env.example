# External URL of AIOMetadata. Must match how clients reach it
# (caddy/.env AIOMETADATA_DOMAIN).
HOST_NAME=https://aiometadata.example.com

# Protects AIOMetadata's /api/dashboard only, not catalogs/configure.
# Generate via: openssl rand -hex 32
ADMIN_KEY=

# Gates AIOMetadata config creation behind login.
# Generate via: openssl rand -hex 16
ADDON_PASSWORD=

# Must match redis/.env PASSWORD.
REDIS_PASSWORD=

# Server-side API keys, used for any config that doesn't bring its own.
# They never leave the server. Every request is billed to them, so mind the
# providers' rate limits. Empty = users must supply their own.
BUILT_IN_TMDB_API_KEY=
BUILT_IN_TVDB_API_KEY=
BUILT_IN_FANART_API_KEY=
# These two cost money, spent by every user of the instance (MDBList bills
# past 1000 calls a day, Gemini per AI search query): set them only while
# config creation stays private (ADDON_PASSWORD).
BUILT_IN_MDBLIST_API_KEY=
BUILT_IN_GEMINI_API_KEY=

# Your AIOMetadata config UUID(s), comma-separated (up to 5): the ID in your
# manifest URL. Their catalogs are rebuilt in the background daily, so they
# open from cache. Leave empty to skip catalog warming.
CACHE_WARMUP_UUIDS=
