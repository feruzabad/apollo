# External URL of AIOStreams. Must match how clients reach it
# (caddy/.env AIOSTREAMS_DOMAIN).
BASE_URL=https://aiostreams.example.com

# Encrypts AIOStreams' stored configs. Immutable after first run.
# Generate via: openssl rand -hex 32
SECRET_KEY=

# AIOStreams admin logins, comma-separated user:pass entries. Required, else
# open admin access. Also gates config creation.
# Generate via: echo "$(openssl rand -hex 10):$(openssl rand -hex 10)"
AIOSTREAMS_AUTH=

# Must match redis/.env PASSWORD.
REDIS_PASSWORD=

# NZBHydra2 API key: Hydra generates it on first start (Config > Main >
# API key). Copy it here, then restart AIOStreams. Until set, the NZBHydra
# addon is unavailable.
BUILTIN_NZBHYDRA_API_KEY=
