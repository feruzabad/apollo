# IP that Prowlarr's web UI (9696, plain HTTP) binds to.
#
# CAUTION: Set this to an internal IP (e.g. your Tailscale IP from
# `tailscale ip -4`), or keep 127.0.0.1 and access it via an SSH tunnel.
# Don't bind to a public interface: indexer credentials live here.
INTERFACE=127.0.0.1

# Prowlarr API key. Must match aiostreams/.env BUILTIN_PROWLARR_API_KEY.
# Generate via: openssl rand -hex 16
PROWLARR__AUTH__APIKEY=
